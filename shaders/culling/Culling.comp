#version 460

#include "CullingInclude.glsl"

layout(set = GLOBAL_SET, binding = BINDING_CAMERA_BUFFER) readonly buffer CameraDataBuffer
{
    CameraData data;
} _Camera[];

layout(set = GLOBAL_SET, binding = BINDING_INSTANCE_DATA_BUFFER, std430) readonly buffer InstanceDataBuffer
{
    InstanceData data[];
} _Instances;

layout(set = GLOBAL_SET, binding = BINDING_VISIBLE_INSTANCE_INDIRECTION_BUFFER) writeonly buffer VisibleInstanceIndirectionBuffer
{
    uint data[];
} _VisibleInstanceIndirection[];

vec3 Bbox[8] =
{
    vec3(-1.0, -1.0, -1.0),
    vec3(1.0, -1.0, -1.0),
    vec3(-1.0, 1.0, -1.0),
    vec3(-1.0, -1.0, 1.0),
    vec3(1.0, 1.0, -1.0),
    vec3(1.0, -1.0, 1.0),
    vec3(-1.0, 1.0, 1.0),
    vec3(1.0, 1.0, 1.0)
};

void TransformBBOX(mat4 transform, vec3 AabbMin, vec3 AabbMax, out vec3 outAabbMin, out vec3 outAabbMax)
{
    vec3 center = (AabbMin + AabbMax) * 0.5;
    vec3 extent = (AabbMax - AabbMin) * 0.5;

    outAabbMin = vec3(1e7);
    outAabbMax = vec3(-1e7);
    for(int i = 0; i < 8; i++)
    {
        vec4 point = vec4(center + Bbox[i] * extent, 1.0);
        point = transform * point;
        point.xyz /= point.w;
        outAabbMin = min(outAabbMin, point.xyz);
        outAabbMax = max(outAabbMax, point.xyz);
    }
}

bool TransformBBOXPerspective(mat4 transform, vec3 AabbMin, vec3 AabbMax, out vec3 outAabbMin, out vec3 outAabbMax)
{
    vec3 center = (AabbMin + AabbMax) * 0.5;
    vec3 extent = (AabbMax - AabbMin) * 0.5;

    outAabbMin = vec3(1e7);
    outAabbMax = vec3(-1e7);

    float minZ = outAabbMin.z;
    for(int i = 0; i < 8; i++)
    {
        vec4 point = vec4(center + Bbox[i] * extent, 1.0);
        point = transform * point;
        minZ = min(minZ, point.z);
        point.xyz /= point.w;
        outAabbMin = min(outAabbMin, point.xyz);
        outAabbMax = max(outAabbMax, point.xyz);
    }

    return minZ <= 0.0;
}

bool FustumCulling(CameraData camera, vec3 center, vec3 extent)
{
    for(int i = 0; i < 6; i++)
    {
        Plane plane = camera.FrustumPlanes[i];
        vec3 s = step(vec3(0.0), plane.Normal);
        vec3 point = mix(center - extent, center + extent, s);

        bool isVisible = dot(plane.Normal, point) + plane.Distance > 0.0;
        if(!isVisible) return false;
    }

    return true;
}

bool Culling(CameraData camera, InstanceData instance)
{
    vec3 wsAABBMin, wsAABBMax;
    TransformBBOX(instance.LocalToWorldMatrix, instance.AabbMin, instance.AabbMax, wsAABBMin, wsAABBMax);

    bool isVisible = FustumCulling(camera, (wsAABBMin + wsAABBMax) * 0.5, (wsAABBMax - wsAABBMin) * 0.5);
    if(isVisible)
    {
        vec3 ssAABBMin, ssAABBMax;
        bool isBehindCamera = TransformBBOXPerspective(camera.ViewProjectionMatrix, wsAABBMin, wsAABBMax, ssAABBMin, ssAABBMax);

        vec2 screenMin = (ssAABBMin.xy * 0.5 + 0.5) * vec2(push.gConstants.HizSize);
        vec2 screenMax = (ssAABBMax.xy * 0.5 + 0.5) * vec2(push.gConstants.HizSize);

        screenMin = clamp(screenMin, vec2(0.0), vec2(push.gConstants.HizSize) - 1.0);
        screenMax = clamp(screenMax, vec2(0.0), vec2(push.gConstants.HizSize) - 1.0);

        vec2 size = screenMax - screenMin;
        float maxDim = max(size.x, size.y);

        int LOD = int(floor(log2(max(maxDim, 1.0))));

        ivec2 mipResolution = ivec2(max(uvec2(1), push.gConstants.HizSize >> LOD));

        ivec2 texMin = clamp(ivec2(floor(screenMin)) >> LOD, ivec2(0), mipResolution - 1);
        ivec2 texMax = clamp(ivec2(floor(screenMax)) >> LOD, ivec2(0), mipResolution - 1);

        // In ideal case when mip N goes to N+1 the footprint is 2, however when N is odd footprint is > 2 and therefore can't be represented by sampling 4 pixels, so we need to go one mip higher
        if (texMax.x - texMin.x > 1 || texMax.y - texMin.y > 1)
        {
            LOD += 1;
            mipResolution = ivec2(max(uvec2(1), push.gConstants.HizSize >> LOD));
            texMin = clamp(ivec2(floor(screenMin)) >> LOD, ivec2(0), mipResolution - 1);
            texMax = clamp(ivec2(floor(screenMax)) >> LOD, ivec2(0), mipResolution - 1);
        }

        float v0 = texelFetch(uTextures[push.gConstants.HizIndex], ivec2(texMin.x, texMin.y), LOD).r;
        float v1 = texelFetch(uTextures[push.gConstants.HizIndex], ivec2(texMax.x, texMin.y), LOD).r;
        float v2 = texelFetch(uTextures[push.gConstants.HizIndex], ivec2(texMin.x, texMax.y), LOD).r;
        float v3 = texelFetch(uTextures[push.gConstants.HizIndex], ivec2(texMax.x, texMax.y), LOD).r;

        float v = max(max(v0, v1), max(v2, v3));

        float minZ = ssAABBMin.z;
        bool isInFrontOfHiZ = minZ <= v;

        isVisible = isBehindCamera || isInFrontOfHiZ;
    }

    return isVisible;
}

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    uint globalIndex = gl_GlobalInvocationID.x;
    if (globalIndex >= push.Constants.InstanceCount) return;

    bool isVisible = Culling(_Camera[push.gConstants.Cameras].data, _Instances.data[globalIndex]);

    if(isVisible)
    {
        uint meshIndex = _Instances.data[globalIndex].MeshIndex;
        uint countIndex = atomicAdd(_VisibleDrawIndexedIndirect[push.gConstants.VisibleDrawIndirects].data[meshIndex].instanceCount, 1);

        DrawIndexedIndirectPadded indirectCommand = _DrawIndexedIndirect.data[meshIndex];
        uint instanceIndex = indirectCommand.firstInstance + countIndex;

        _VisibleInstanceIndirection[push.gConstants.VisibleInstanceIndirections].data[instanceIndex] = globalIndex;
    }
}
